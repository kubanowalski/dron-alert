generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  type        String
  description String
  location    String
  status      String   @default("REPORTED")
  photoUrl    String?
  userId      String
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  firstName String?
  lastName  String?
  role      String     @default("USER")
  createdAt DateTime   @default(now())
  updatedAt DateTime
  Incident  Incident[]
}
